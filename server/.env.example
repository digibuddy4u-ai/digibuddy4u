# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Replace <DB_USERNAME> and <DB_PASSWORD> with your Atlas DB credentials)
MONGODB_URI=mongodb+srv://<DB_USERNAME>:<DB_PASSWORD>@cluster0.4pdhwme.mongodb.net/digibuddy4u?retryWrites=true&w=majority

# JWT Secret & Expiry
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma separated)
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Initial Admin Seed Credentials (used by `npm run seed`)
INITIAL_ADMIN_NAME=DigiBuddy Admin
INITIAL_ADMIN_EMAIL=admin@digibuddy4u.com
INITIAL_ADMIN_PASSWORD=your_secure_admin_password_here
