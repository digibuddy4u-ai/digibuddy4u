# ==========================================
# DigiBuddy4U Server - Environment Variables
# ==========================================

# Server Port (Hostinger sets this automatically, default 5000)
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
# 1. Replace <DB_USERNAME> and <DB_PASSWORD> with your MongoDB Atlas database user credentials.
# 2. In MongoDB Atlas, go to Network Access -> Add IP Address -> Allow Access From Anywhere (0.0.0.0/0)
MONGODB_URI=mongodb+srv://<DB_USERNAME>:<DB_PASSWORD>@cluster0.4pdhwme.mongodb.net/digibuddy4u?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# CORS Allowed Origins
CLIENT_URL=https://digibuddy4u.vercel.app
ADMIN_URL=https://admin.digibuddy4u.com
CORS_ORIGIN=https://digibuddy4u.vercel.app,https://admin.digibuddy4u.com,http://localhost:3000,http://localhost:3001

# Initial Admin Credentials (used by `npm run seed`)
INITIAL_ADMIN_NAME=DigiBuddy Admin
INITIAL_ADMIN_EMAIL=admin@digibuddy4u.com
INITIAL_ADMIN_PASSWORD=your_secure_admin_password_here
