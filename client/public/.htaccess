# ----------------------------------------------------------------------
# DigiBuddy4U Client - Hostinger LiteSpeed / Apache SPA Routing Fallback
# ----------------------------------------------------------------------

# Ensure index.html is the default directory index document
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Never rewrite real physical files (js, css, images, svg, png, webp, jpg, xml, txt)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 3. If a physical directory has a valid index.html, serve it directly
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^ - [L]

  # 4. If an exact prerendered .html file exists, serve it (supports both /packages and /packages/)
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

  # 5. Fallback all remaining frontend routes / directories without index.html to /index.html
  RewriteCond %{REQUEST_URI} !^/index\.html
  RewriteRule ^ index.html [L]
</IfModule>

# Prevent directory indexing
Options -Indexes

# MIME types for modern favicons, SVG and PWA manifest
<IfModule mod_mime.c>
  AddType image/x-icon .ico
  AddType image/png .png
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
</IfModule>

# Security & CORS Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Browser Caching for Production Performance
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType application/manifest+json "access plus 1 week"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>
